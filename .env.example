# Tharun Portfolio Environment Variables

# Render Express API base URL (no trailing slash)
# Local dev: leave empty (empty string = same-origin)
# Production: https://triocraft-api.onrender.com
VITE_API_URL=

# Contact Form Integration (Optional)
# Option 1: Web3Forms access key (Get free from https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=

# Option 2: Formspree endpoint (e.g., https://formspree.io/f/your_form_id)
VITE_FORMSPREE_ENDPOINT=

# Option 3: Custom Serverless/Backend API endpoint (e.g., https://api.yourdomain.com/contact)
VITE_CONTACT_API_URL=

# Public Contact Details
